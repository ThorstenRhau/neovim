{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "LuaJIT"
  },
  "workspace": {
    "library": [
      "$VIMRUNTIME",
      "~/.local/share/nvim/site/pack/core/opt/blink.cmp/lua",
      "~/.local/share/nvim/site/pack/core/opt/brygga.nvim/lua",
      "~/.local/share/nvim/site/pack/core/opt/conform.nvim/lua",
      "~/.local/share/nvim/site/pack/core/opt/fzf-lua/lua",
      "~/.local/share/nvim/site/pack/core/opt/gitsigns.nvim/lua",
      "~/.local/share/nvim/site/pack/core/opt/lualine.nvim/lua",
      "~/.local/share/nvim/site/pack/core/opt/mini.align/lua",
      "~/.local/share/nvim/site/pack/core/opt/mini.clue/lua",
      "~/.local/share/nvim/site/pack/core/opt/mini.icons/lua",
      "~/.local/share/nvim/site/pack/core/opt/mini.splitjoin/lua",
      "~/.local/share/nvim/site/pack/core/opt/neogit/lua",
      "~/.local/share/nvim/site/pack/core/opt/nvim-lint/lua",
      "~/.local/share/nvim/site/pack/core/opt/nvim-lspconfig/lua",
      "~/.local/share/nvim/site/pack/core/opt/nvim-treesitter/lua",
      "~/.local/share/nvim/site/pack/core/opt/nvim-treesitter-textobjects/lua",
      "~/.local/share/nvim/site/pack/core/opt/oil.nvim/lua",
      "~/.local/share/nvim/site/pack/core/opt/render-markdown.nvim/lua",
      "~/.local/share/nvim/site/pack/core/opt/schemastore.nvim/lua",
      "~/.local/share/nvim/site/pack/core/opt/token/lua"
    ]
  },
  "diagnostics": {
    "disable": [
      "missing-fields",
      "param-type-mismatch",
      "assign-type-mismatch",
      "unnecessary-if"
    ]
  }
}
