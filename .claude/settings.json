{
  "extraKnownMarketplaces": {
    "nvim-config": {
      "source": { "source": "directory", "path": "./.claude/marketplace" }
    }
  },
  "enabledPlugins": {
    "emmylua-lsp@nvim-config": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/make-check.sh"
          }
        ]
      }
    ]
  }
}
